{
  "name": "fotografia-producao-imagens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node --experimental-strip-types scripts/prepare.mjs && tsc --noEmit && vite build",
